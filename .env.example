# --- Database (Supabase Postgres) ---
# Browser-only deploy uses ONE connection string for everything (runtime + db push + seed).
# In Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
# The Session pooler supports `prisma db push` AND works at runtime.
# (Do NOT use the Transaction pooler on 6543 for this single-URL setup — it can't run db push.)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# 32+ char random secret. Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-32-char-random-string-here"

# --- App ---
NEXT_PUBLIC_APP_URL="https://your-site.netlify.app"

# --- Email ---
EMAIL_PROVIDER="mock"
# RESEND_API_KEY="re_..."   # for future email integration
