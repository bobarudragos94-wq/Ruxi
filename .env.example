# --- Database (Supabase Postgres) ---
# Use the Supabase "Connection pooling" (Transaction) string for the app at runtime.
# It looks like: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional: direct (non-pooled, port 5432) connection used only for migrations / db push / seed.
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# 32+ char random secret. Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-32-char-random-string-here"

# --- App ---
NEXT_PUBLIC_APP_URL="https://your-site.netlify.app"

# --- Email ---
EMAIL_PROVIDER="mock"
# RESEND_API_KEY="re_..."   # for future email integration
